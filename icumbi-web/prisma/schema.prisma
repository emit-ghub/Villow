generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ListingStatus {
  PUBLISHED
  PENDING
  SOLD
  OFF_MARKET
}

enum PropertyType {
  HOUSE
  CONDO
  TOWNHOME
  MULTI_FAMILY
  LAND
  APARTMENT
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  favorites  Favorite[]
  listings   Listing[]    @relation("OwnerListings")
  searches   SearchHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model City {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  state     String
  country   String    @default("USA")
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  listings Listing[]

  @@index([state, name])
}

model Listing {
  id             String        @id @default(cuid())
  ownerId        String?
  cityId         String?
  externalId     String?       @unique
  title          String
  description    String        @db.Text
  status         ListingStatus @default(PUBLISHED)
  propertyType   PropertyType
  price          Int
  hoaFee         Int?          @default(0)
  bedrooms       Int
  bathrooms      Decimal       @db.Decimal(4, 1)
  squareFeet     Int?
  lotSize        Int?
  yearBuilt      Int?
  addressLine1   String
  addressLine2   String?
  postalCode     String
  latitude       Decimal?      @db.Decimal(10, 7)
  longitude      Decimal?      @db.Decimal(10, 7)
  walkthroughUrl String?
  primaryImage   String?
  tags           String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner   User?   @relation("OwnerListings", fields: [ownerId], references: [id])
  city    City?   @relation(fields: [cityId], references: [id])
  media   ListingMedia[]
  favorites Favorite[]

  @@index([cityId, status])
  @@index([price])
  @@index([latitude, longitude])
}

model ListingMedia {
  id        String   @id @default(cuid())
  listingId String
  url       String
  alt       String?
  width     Int?
  height    Int?
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, order])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String?
  query        String
  filters      Json?
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
